{
  "name": "glowbydilek-website",
  "version": "0.1.0",
  "description": "Official website for Glow by Dilek – premium waxing & beauty in the Netherlands",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prepare-swc-wasm.mjs && node scripts/db-migrate.mjs --on-build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "photos": "node scripts/optimize-photos.mjs",
    "brand:logos": "node scripts/brand/build-logos.cjs",
    "check:site": "node scripts/check-site.mjs",
    "test:e2e": "node scripts/e2e-navigation.cjs",
    "test:e2e:private": "node scripts/e2e-private.cjs",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/register.mjs --test --test-concurrency=1 tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glowbydilek/glowbydilek-website-.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/glowbydilek/glowbydilek-website-/issues"
  },
  "homepage": "https://github.com/glowbydilek/glowbydilek-website-#readme",
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@next/swc-wasm-nodejs": "16.4.2",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.5.2",
    "pdfkit": "0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "fontkit": "2.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  }
}
