# Copy to .env.local for development. NEVER commit real values.
# Production values are set only in Hostinger → Node.js app → Environment
# variables (see docs/DEPLOYMENT.md). Keep development and production separate.

# Public URL of the website (canonical URLs, sitemap, Open Graph, email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────
# Development: a local database. Production (Hostinger): host 127.0.0.1.
DATABASE_URL=mysql://glow:devpass@127.0.0.1:3306/glow_dev
# Run migrations automatically during `npm run build` (set true on Hostinger).
DB_MIGRATE_ON_BUILD=false
# Optional: connection pool size (default 5).
# DATABASE_POOL_SIZE=5
# Tests only: an EMPTY throwaway database. Tests delete all rows in it.
# TEST_DATABASE_URL=mysql://glow:devpass@127.0.0.1:3306/glow_test

# ── Private areas (/admin, /ajanda) ──────────────────────────────────────
# At least 32 random characters, e.g. `openssl rand -base64 48`. Production
# must use its own value. Changing it signs everyone out and invalidates MFA.
AUTH_SECRET=
# The single owner account (created automatically, without a password; the
# first password is set via "Wachtwoord vergeten?").
OWNER_EMAIL=hello@glowbydilek.nl
# Bearer secret for /api/cron/tick (at least 24 characters).
CRON_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Development: use a local SMTP sink, never the real mailbox (no real
# customer emails from test systems).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@glowbydilek.nl
SMTP_PASS=
MAIL_TO=hello@glowbydilek.nl
MAIL_FROM_NAME=Glow by Dilek

# Optional: WhatsApp number, digits only incl. country code (e.g. 31612345678). Empty = button hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Cloudflare Turnstile ─────────────────────────────────────────────────
# Production: real keys (site key is baked in at BUILD time). Without keys in
# production the public forms refuse submissions (never silent test keys).
# Development: leave empty to use Cloudflare's official test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames accepted by the server-side check
# (defaults to the host of NEXT_PUBLIC_SITE_URL plus its www. variant).
TURNSTILE_ALLOWED_HOSTNAMES=
# Only when the site is proxied through Cloudflare (orange cloud):
# TRUST_CF_CONNECTING_IP=true

# ── Local production-mode testing ONLY (never set on Hostinger) ──────────
# TURNSTILE_ALLOW_TEST_KEYS=true   # allow test keys in a local `next start`
# INSECURE_COOKIES=true            # session cookie over plain http://localhost
