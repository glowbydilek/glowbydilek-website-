# Public URL of the website (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://glowbydilek.nl

# Contact & appointment forms (set in Hostinger → Environment variables; never commit real values)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@glowbydilek.nl
SMTP_PASS=
MAIL_TO=hello@glowbydilek.nl
MAIL_FROM_NAME=Glow by Dilek

# Optional: WhatsApp number, digits only incl. country code (e.g. 31612345678). Empty = button hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
