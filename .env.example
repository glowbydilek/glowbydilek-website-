# Public URL of the website (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://glowbydilek.nl

# Contact & appointment forms (set in Hostinger → Environment variables; never commit real values)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@glowbydilek.nl
SMTP_PASS=
MAIL_TO=hello@glowbydilek.nl
MAIL_FROM_NAME=Glow by Dilek

# Optional: WhatsApp number, digits only incl. country code (e.g. 31612345678). Empty = button hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudflare Turnstile (spam protection on both forms).
# Create a widget in the Cloudflare dashboard (Turnstile → Add widget) with
# the hostnames glowbydilek.nl and www.glowbydilek.nl. The site key is public
# and is baked in at build time; the secret key is server-only.
# Leave both empty to use Cloudflare's official TEST keys (every token passes —
# fine for development, NOT protection in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames accepted by the server-side check
# (defaults to the host of NEXT_PUBLIC_SITE_URL plus its www. variant).
TURNSTILE_ALLOWED_HOSTNAMES=
# Only when the site is proxied through Cloudflare (orange cloud):
# TRUST_CF_CONNECTING_IP=true
